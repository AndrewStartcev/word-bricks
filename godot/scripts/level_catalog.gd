static func get_location(location_id: String) -> Dictionary:
	var value: Variant = LOCATIONS.get(location_id, {})
	return value as Dictionary


static func get_level(location_id: String, level_number: int) -> Dictionary:
	var location: Dictionary = get_location(location_id)
	if location.is_empty():
		return {}
	var levels: Array = location.get("levels", []) as Array
	if levels.is_empty():
		return {}
	var index: int = clampi(level_number - 1, 0, levels.size() - 1)
	return levels[index] as Dictionary


static func location_title(location_id: String) -> String:
	return String(get_location(location_id).get("title", ""))


static func location_number(location_id: String) -> int:
	return int(get_location(location_id).get("number", 0))


static func level_title(location_id: String, level_number: int) -> String:
	return String(get_level(location_id, level_number).get("title", ""))


static func next_location(location_id: String) -> String:
	var index: int = LOCATION_ORDER.find(location_id)
	if index < 0 or index >= LOCATION_ORDER.size() - 1:
		return ""
	return LOCATION_ORDER[index + 1]


static func previous_location(location_id: String) -> String:
	var index: int = LOCATION_ORDER.find(location_id)
	if index <= 0:
		return ""
	return LOCATION_ORDER[index - 1]
